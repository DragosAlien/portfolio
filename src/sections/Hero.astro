---
import Download from '@lucide/astro/icons/download';
import { useTranslations, type Locale } from '~/i18n';
import { profile, publicFile, socialLinks as socials } from '~/data/profile';
import ExternalLink from '~/components/ExternalLink.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const cv = publicFile(profile.cv[locale]);
const [first, ...rest] = profile.name.split(' ');
---

<section class="wrap pt-12 pb-14 md:pt-20 md:pb-20">
  <p class="reveal flex items-center gap-3 font-mono text-meta text-muted" style="--i:0">
    <span aria-hidden="true" class="pulse relative size-1.5 shrink-0 rounded-full bg-accent"></span>
    <span>{t.hero.title} · {profile.current.company}</span>
  </p>

  <!-- The alien sits on the first name (data-perch, see Alien); the line box starts above the capitals. -->
  <h1 class="reveal mt-16 text-display font-medium uppercase md:mt-14" style="--i:1">
    <span data-perch="sit" data-perch-dy="0.1" class="inline-block">{first}</span><br />{rest.join(' ')}
  </h1>

  <p class="reveal mt-8 max-w-measure text-lg text-pretty text-fg/85 md:mt-10" style="--i:2">{t.hero.lead}</p>

  <div class="reveal mt-8 flex flex-wrap items-center gap-x-6 gap-y-4" style="--i:3">
    <div class="flex flex-wrap gap-3">
      <a
        href="#work"
        class="rounded-md bg-fg px-4 py-2 text-sm font-medium text-bg transition-colors duration-150 hover:bg-fg/85"
      >
        {t.hero.viewWork}
      </a>
      {
        cv && (
          <a
            href={cv}
            download
            class="inline-flex items-center gap-2 rounded-md border border-line-strong px-4 py-2 text-sm font-medium transition-colors duration-150 hover:border-muted"
          >
            <Download size={15} aria-hidden="true" />
            {t.hero.downloadCv}
          </a>
        )
      }
    </div>
    {
      socials.length > 0 && (
        <ul class="flex gap-5 text-sm text-muted">
          {socials.map((s) => (
            <li>
              <ExternalLink href={s.href} newTabLabel={t.a11y.opensInNewTab} class="transition-colors duration-150 hover:text-fg">
                {s.label}
              </ExternalLink>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <p class="reveal mt-14 border-t border-line pt-4 font-mono text-meta text-muted md:mt-20" style="--i:4">
    {profile.location.city}, {profile.location.region[locale]}
    <span data-clock={profile.location.timeZone} hidden> · <time></time> {t.hero.localTime}</span>
  </p>
</section>

<script>
  // Local time next to the location; without JS the row just shows the place.
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  if (clock) {
    const time = clock.querySelector('time')!;
    const fmt = new Intl.DateTimeFormat(document.documentElement.lang, {
      hour: '2-digit',
      minute: '2-digit',
      timeZone: clock.dataset.clock,
    });
    const tick = () => (time.textContent = fmt.format(new Date()));
    tick();
    setInterval(tick, 15_000);
    clock.hidden = false;
  }
</script>
