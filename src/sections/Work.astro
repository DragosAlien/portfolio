---
import { useTranslations, type Locale } from '~/i18n';
import { profile } from '~/data/profile';
import { projects, type Project } from '~/data/projects';
import Section from '~/components/Section.astro';
import TechList from '~/components/TechList.astro';
import ExternalLink from '~/components/ExternalLink.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);

const groups: { id: string; heading: string; note?: string; items: Project[] }[] = [
  {
    id: 'professional',
    heading: t.work.professional,
    note: t.work.professionalNote,
    items: projects.filter((p) => p.category === 'professional'),
  },
  { id: 'open-source', heading: t.work.openSource, items: projects.filter((p) => p.category === 'open-source') },
].filter((g) => g.items.length > 0);
---

<Section id="work" heading={t.work.heading}>
  <div class="space-y-12">
    {
      groups.map((g) => (
        <div>
          <h3 class="text-sm font-medium text-muted">{g.heading}</h3>
          {g.note && <p class="mt-1 max-w-measure text-sm text-muted">{g.note}</p>}
          <ul class="mt-4 divide-y divide-line border-y border-line">
            {g.items.map((p) => (
              <li class="grid gap-3 py-6 md:grid-cols-[minmax(0,1fr)_auto] md:gap-x-10">
                <div class="min-w-0">
                  <h4 class="font-medium">{p.name[locale]}</h4>
                  <p class="mt-2 max-w-measure text-sm text-fg/80">{p.description[locale]}</p>
                  <TechList items={p.tech} class="mt-3" />
                </div>
                <div class="flex flex-wrap items-start gap-x-5 gap-y-1 text-meta md:flex-col md:items-end md:text-right">
                  <p class="font-mono text-muted">
                    <span>{p.year}</span> <span class="ml-2">{p.status[locale]}</span>
                  </p>
                  {p.repository && (
                    <ExternalLink href={p.repository} newTabLabel={t.a11y.opensInNewTab} class="link">
                      {t.work.repository}
                    </ExternalLink>
                  )}
                  {p.demo && (
                    <ExternalLink href={p.demo} newTabLabel={t.a11y.opensInNewTab} class="link">
                      {t.work.demo}
                    </ExternalLink>
                  )}
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
    {
      profile.github && (
        <ExternalLink href={profile.github} newTabLabel={t.a11y.opensInNewTab} class="link text-sm">
          {t.work.allRepos}
        </ExternalLink>
      )
    }
  </div>
</Section>
