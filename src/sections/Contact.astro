---
import { Image } from 'astro:assets';
import photo from '~/assets/profile.jpg';
import { useTranslations, type Locale } from '~/i18n';
import { profile, publicFile, socialLinks } from '~/data/profile';
import Section from '~/components/Section.astro';
import ExternalLink from '~/components/ExternalLink.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
const cv = publicFile(profile.cv[locale]);

type Row = { label: string; href: string; text: string; kind: 'external' | 'download' };
const rows: Row[] = [
  ...socialLinks.map((s) => ({ label: s.label, href: s.href, text: s.handle, kind: 'external' as const })),
  ...(cv ? [{ label: 'CV', href: cv, text: `${t.hero.downloadCv} (PDF)`, kind: 'download' as const }] : []),
];
---

<Section id="contact" index={5} heading={t.contact.heading}>
  <div class="flex items-center gap-4">
    <Image
      src={photo}
      alt={profile.name}
      width={64}
      height={64}
      densities={[1, 2]}
      class="size-14 shrink-0 rounded-full bg-surface object-cover ring-1 ring-line sm:size-16"
    />
    <p class="max-w-measure text-balance">{t.contact.body}</p>
  </div>
  {
    profile.email && (
      <a
        href={`mailto:${profile.email}`}
        aria-label={`${t.contact.email}: ${profile.email}`}
        class="link mt-6 inline-block text-xl font-medium tracking-tight break-all md:text-3xl lg:text-4xl"
      >
        {profile.email}
      </a>
    )
  }
  <dl data-perch="sit" class="mt-8 space-y-4 text-sm sm:space-y-2">
    {
      rows.map((r) => (
        <div class="flex flex-col sm:flex-row sm:gap-6">
          <dt class="w-24 shrink-0 font-mono text-meta leading-6 text-muted">{r.label}</dt>
          <dd class="min-w-0 break-words">
            {r.kind === 'external' ? (
              <ExternalLink href={r.href} newTabLabel={t.a11y.opensInNewTab} class="link">
                {r.text}
              </ExternalLink>
            ) : (
              <a href={r.href} download class="link">
                {r.text}
              </a>
            )}
          </dd>
        </div>
      ))
    }
  </dl>
</Section>
