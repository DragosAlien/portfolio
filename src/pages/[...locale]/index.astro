---
import { defaultLocale, locales, useTranslations, type Locale } from '~/i18n';
import BaseLayout from '~/layouts/BaseLayout.astro';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import CommandPalette from '~/components/CommandPalette.astro';
import Alien from '~/components/Alien.astro';
import Hero from '~/sections/Hero.astro';
import About from '~/sections/About.astro';
import Work from '~/sections/Work.astro';
import Experience from '~/sections/Experience.astro';
import Stack from '~/sections/Stack.astro';
import Contact from '~/sections/Contact.astro';

// One file renders every locale: `/` for the default language, `/<locale>/` for the others.
export function getStaticPaths() {
  return locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }));
}

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);
const path = '';
---

<BaseLayout locale={locale} title={t.meta.title} description={t.meta.description} path={path}>
  <Header locale={locale} path={path} />
  <main id="main">
    <Hero locale={locale} />
    <About locale={locale} />
    <Work locale={locale} />
    <Experience locale={locale} />
    <Stack locale={locale} />
    <Contact locale={locale} />
  </main>
  <Footer locale={locale} />
  <CommandPalette locale={locale} path={path} />
  <Alien label={t.alien.label} lines={t.alien.lines} abducted={t.alien.abducted} />
</BaseLayout>
