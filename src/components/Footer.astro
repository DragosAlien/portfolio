---
import { useTranslations, type Locale } from '~/i18n';
import { profile, repository as source } from '~/data/profile';
import ExternalLink from './ExternalLink.astro';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = useTranslations(locale);
---

<footer class="wrap">
  <div class="flex flex-col gap-2 border-t border-line py-8 text-meta text-muted sm:flex-row sm:justify-between">
    <p>© {new Date().getFullYear()} {profile.name}</p>
    <p>
      {t.footer.builtWith}
      {
        source && (
          <>
            {' '}
            <ExternalLink href={source} newTabLabel={t.a11y.opensInNewTab} class="link">
              {t.footer.source}
            </ExternalLink>
          </>
        )
      }
    </p>
  </div>
</footer>
