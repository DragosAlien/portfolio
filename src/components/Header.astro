---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { useTranslations, type Locale } from '~/i18n';
import { profile } from '~/data/profile';
import LanguageSwitcher from './LanguageSwitcher.astro';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  locale: Locale;
  path: string;
}
const { locale, path } = Astro.props;
const t = useTranslations(locale);
const links = [
  { href: '#work', label: t.nav.work },
  { href: '#experience', label: t.nav.experience },
  { href: '#stack', label: t.nav.stack },
  { href: '#contact', label: t.nav.contact },
];
---

<header class="sticky top-0 z-40 border-b border-line bg-bg/85 backdrop-blur-sm">
  <div class="wrap flex h-14 items-center justify-between gap-6">
    <a href={getRelativeLocaleUrl(locale, '')} class="text-sm font-medium">{profile.name}</a>
    <div class="flex items-center gap-4 md:gap-6">
      <nav aria-label={t.a11y.mainNav} class="hidden md:block">
        <ul class="flex gap-4 text-sm text-muted">
          {
            links.map((l) => (
              <li>
                <a href={l.href} class="inline-flex h-9 items-center px-1 transition-colors duration-150 hover:text-fg">
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <div class="flex items-center gap-2">
        <ThemeToggle label={t.a11y.darkTheme} />
        <LanguageSwitcher locale={locale} path={path} label={t.a11y.languageNav} />
      </div>
    </div>
  </div>
</header>
