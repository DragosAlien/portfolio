---
import Moon from '@lucide/astro/icons/moon';
import Sun from '@lucide/astro/icons/sun';

interface Props {
  /** Localized "Dark theme"; the button is a toggle, so the label names the state, not the action. */
  label: string;
}
const { label } = Astro.props;
---

<button
  type="button"
  data-theme-toggle
  aria-label={label}
  aria-pressed="true"
  class="inline-flex size-9 items-center justify-center rounded-md text-muted transition-colors duration-150 hover:text-fg"
>
  <Moon size={16} aria-hidden="true" class="theme-dark-only" />
  <Sun size={16} aria-hidden="true" class="theme-light-only" />
</button>

<style>
  :global(:root[data-theme='light']) .theme-dark-only,
  :global(:root:not([data-theme='light'])) .theme-light-only {
    display: none;
  }
</style>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const button = document.querySelector('[data-theme-toggle]');
    const sync = () => button.setAttribute('aria-pressed', String(root.dataset.theme !== 'light'));
    sync();
    const apply = () => {
      root.dataset.theme = root.dataset.theme === 'light' ? 'dark' : 'light';
      try {
        localStorage.setItem('theme', root.dataset.theme);
      } catch {}
      document.querySelector('meta[name="theme-color"]').content = getComputedStyle(root).getPropertyValue('--color-bg').trim();
      sync();
    };
    button.addEventListener('click', () => {
      if (!document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) return apply();
      // The new theme grows as a circle from the toggle.
      const r = button.getBoundingClientRect();
      const x = r.left + r.width / 2;
      const y = r.top + r.height / 2;
      const end = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
      document.startViewTransition(apply).ready.then(() => {
        root.animate(
          { clipPath: [`circle(0 at ${x}px ${y}px)`, `circle(${end}px at ${x}px ${y}px)`] },
          { duration: 550, easing: 'cubic-bezier(0.2, 0.7, 0.2, 1)', pseudoElement: '::view-transition-new(root)' },
        );
      });
    });
  })();
</script>
