---
interface Props {
  id: string;
  heading: string;
}
const { id, heading } = Astro.props;
---

<section id={id} aria-labelledby={`${id}-heading`} class="wrap">
  <div class="grid gap-6 border-t border-line py-12 md:grid-cols-12 md:gap-8 md:py-16">
    <h2 id={`${id}-heading`} class="font-medium md:col-span-3">{heading}</h2>
    <div class="min-w-0 md:col-span-9">
      <slot />
    </div>
  </div>
</section>
